# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Only NEXT_PUBLIC_* values reach the browser.

# ─── Required ────────────────────────────────────────────────────────────────
# Deployed VeriPayEscrow. This is the live Monad-testnet deployment; keep it
# to run against the same contract the demo uses.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x00bdf9fbc9f59cc6814bbc7a91b19bbad1517e6d
# Free at https://thirdweb.com/create-api-key
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
# Your own Supabase project (Project Settings → API). Run supabase/schema.sql in it first.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Any passcode you choose — gates /admin
ADMIN_PASSCODE=

# ─── Pay links (card → naira → escrow) ───────────────────────────────────────
# Paystack TEST keys (Settings → API Keys & Webhooks at paystack.com).
# Without them the card step is skipped and labelled test mode.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Testnet-only key of the wallet that owns the vNGN test token and delivers it
# after a verified card charge. To run this yourself: deploy
# contracts/test/VeriPayTestNaira.sol, put its address below, and use the
# deployer's key here. Never use a key that holds real funds.
PAY_MINTER_PRIVATE_KEY=
NEXT_PUBLIC_NGN_TOKEN_ADDRESS=0xdbb53d0a2d1b91ef6a41cf1128fef562ffc531eb

# ─── Optional ────────────────────────────────────────────────────────────────
# RPC endpoint (e.g. Alchemy's Monad testnet URL). Falls back to the public node.
NEXT_PUBLIC_MONAD_RPC_URL=
# Envio HyperIndex GraphQL endpoint. Without it, reputation is read straight
# from the contract with identical counting rules.
ENVIO_GRAPHQL_URL=
# Override the testnet AUSD address
NEXT_PUBLIC_AUSD_ADDRESS=
# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Naira exchange (pre-hackathon feature) — see EXCHANGE.md
EXCHANGE_SPREAD_PERCENT=3.5
EXCHANGE_MERCHANT_BANK_NAME=
EXCHANGE_MERCHANT_ACCOUNT_NUMBER=
EXCHANGE_MERCHANT_ACCOUNT_NAME=
EXCHANGE_MERCHANT_ADDRESS=
EXCHANGE_PAYOUT_PRIVATE_KEY=
