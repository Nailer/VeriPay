{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "VeriPay",
  "description": "VeriPay is buyer protection for social commerce, built on Monad. A seller shares one link; the buyer sees the seller's on-chain track record, pays in naira with a fingerprint, and the money is held in a smart contract until the order arrives.",
  "colors": {
    "primary": "#09090B",
    "light": "#FAFAFA",
    "dark": "#09090B"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://veripay.store"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "api": {
    "playground": {
      "display": "simple"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "banner": {
    "content": "VeriPay runs on **Monad testnet** (chain 10143). Card payments use Paystack test mode and the naira on-chain is a test token — no real money moves. [Read the honest status →](/security/known-limitations)",
    "dismissible": true
  },
